# Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Flask Settings
FLASK_DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000
HOST=0.0.0.0

# MySQL Database Settings (Optional: system automatically falls back to SQLite if MySQL is offline)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=library_db

# Business Logic Rules
DAILY_FINE_RATE=2.00
DEFAULT_LOAN_DAYS=14
